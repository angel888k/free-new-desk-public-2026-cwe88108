{
  "name": "free-new-desk-public",
  "version": "1.5.0",
  "private": false,
  "description": "Windows 11 x64 desktop media platform with TVBox/FongMi-compatible source architecture.",
  "type": "module",
  "main": "apps/desktop/dist/main/bootstrap.js",
  "author": "Free New Desk contributors",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=24.18.1"
  },
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:packages && npm run build:desktop",
    "build:packages": "npm run build -w @free-new-desk/contracts && npm run build -w @free-new-desk/source-sdk && npm run build -w @free-new-desk/plugin-sdk && npm run build -w @free-new-desk/source-adapters && npm run build -w @free-new-desk/catvod-runtime-shim && npm run build -w @free-new-desk/tvbox-config && npm run build -w @free-new-desk/live-parser && npm run build -w @free-new-desk/epg-parser && npm run build -w @free-new-desk/data-service && npm run build -w @free-new-desk/proxy-service && npm run build -w @free-new-desk/spider-worker && npm run build -w @free-new-desk/plugin-host && npm run build -w @free-new-desk/jvm-spider-host && npm run build -w @free-new-desk/drpy2-worker && npm run build -w @free-new-desk/source-engine",
    "build:desktop": "npm run build -w @free-new-desk/desktop",
    "typecheck": "npm run build:packages && npm run typecheck --workspaces --if-present",
    "typecheck:built": "npm run typecheck --workspaces --if-present",
    "lint": "node scripts/lint.mjs",
    "test": "npm run build:packages && npm run build:desktop && node --test tests/unit/*.test.mjs tests/integration/*.test.mjs",
    "test:built": "node --test tests/unit/*.test.mjs tests/integration/*.test.mjs",
    "verify": "npm run check:public-sanitization && npm run lint && npm run build && npm run typecheck:built && npm run test:built && node scripts/verify-renderer-build.mjs",
    "dev": "npm run dev -w @free-new-desk/desktop",
    "player:configure": "cmake -S native/player-host -B native/player-host/build -A x64",
    "player:build": "cmake --build native/player-host/build --config Release",
    "prepare:icons": "node scripts/materialize-app-icons.mjs",
    "prepare:mpv": "node scripts/ensure-mpv-runtime.mjs",
    "prepare:runtime": "node scripts/prepare-runtime-workspaces.mjs",
    "prepare:builder-tools": "node scripts/prepare-builder-tools.mjs",
    "package:prepare": "npm run prepare:icons && npm run prepare:mpv && npm run player:configure && npm run player:build && npm run build && npm run prepare:runtime",
    "package:win": "npm run package:prepare && node scripts/package-windows.mjs",
    "package:win:signed": "npm run package:prepare && node scripts/package-windows.mjs --signed",
    "release:manifest": "node scripts/release-manifest.mjs",
    "release:manifest:signed": "node scripts/release-manifest.mjs --signed",
    "smoke:packaged": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-packaged-app.ps1",
    "check:public-sanitization": "node scripts/check-public-sanitization.mjs"
  },
  "dependencies": {
    "music-metadata": "11.16.1",
    "pinia": "3.0.3",
    "vue": "3.5.43",
    "vue-router": "4.5.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@vitejs/plugin-vue": "6.0.9",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "typescript": "5.9.2",
    "vite": "7.3.7",
    "vue-tsc": "3.0.6"
  },
  "overrides": {
    "@electron/get": {
      "global-agent": "4.1.3"
    }
  },
  "build": {
    "appId": "org.free-new-desk.desktop",
    "productName": "Free New Desk",
    "asar": true,
    "toolsets": {
      "nsis": "1.2.1"
    },
    "directories": {
      "output": "dist/releases"
    },
    "files": [
      "apps/desktop/dist/**/*",
      "services/source-engine/dist/**/*",
      "services/source-engine/package.json",
      "services/data-service/dist/**/*",
      "services/data-service/package.json",
      "services/proxy-service/dist/**/*",
      "services/proxy-service/package.json",
      "services/spider-worker/dist/**/*",
      "services/spider-worker/package.json",
      "services/drpy2-worker/dist/**/*",
      "services/drpy2-worker/package.json",
      "services/plugin-host/dist/**/*",
      "services/plugin-host/package.json",
      "packages/*/dist/**/*",
      "packages/*/package.json",
      {
        "from": ".packaging/runtime-node-modules",
        "to": "node_modules",
        "filter": [
          "**/*"
        ]
      },
      "package.json",
      {
        "from": "dist",
        "to": ".",
        "filter": [
          "build-provenance.json"
        ]
      },
      "THIRD_PARTY_NOTICES.md"
    ],
    "extraResources": [
      {
        "from": "native/player-host/build/Release/player-host.exe",
        "to": "native/player-host/player-host.exe"
      },
      {
        "from": "third_party/mpv/win-x64",
        "to": "native/player-host",
        "filter": [
          "libmpv-2.dll",
          "SOURCE.txt"
        ]
      },
      {
        "from": "services/jvm-spider-host/dist/jvm-spider-host.jar",
        "to": "jvm/jvm-spider-host.jar"
      },
      {
        "from": "assets/app-icon.png",
        "to": "assets/app-icon.png"
      },
      {
        "from": "assets/app-icon.ico",
        "to": "assets/app-icon.ico"
      },
      {
        "from": "assets/tray-icon.png",
        "to": "assets/tray-icon.png"
      },
      {
        "from": "native/player-host/build/Release/smb-helper.exe",
        "to": "native/player-host/smb-helper.exe"
      }
    ],
    "win": {
      "icon": "assets/app-icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "Free-New-Desk-Setup-${version}-${arch}.${ext}",
      "installerIcon": "assets/app-icon.ico",
      "uninstallerIcon": "assets/app-icon.ico",
      "installerHeaderIcon": "assets/app-icon.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "Free-New-Desk-Portable-${version}-${arch}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "cwe88108",
      "repo": "free-new-desk-public",
      "releaseType": "release"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cwe88108/free-new-desk-public.git"
  }
}
